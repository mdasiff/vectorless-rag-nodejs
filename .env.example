# LLM provider: 'gemini' (free tier), 'anthropic' (paid), or 'bedrock' (AWS)
LLM_PROVIDER=gemini

# --- Google Gemini (when LLM_PROVIDER=gemini) ---
# Get a key from https://aistudio.google.com/apikey (no card required)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic (when LLM_PROVIDER=anthropic) ---
# Get a key from https://console.anthropic.com (Settings -> API Keys; requires credits)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- AWS Bedrock (when LLM_PROVIDER=bedrock) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Retrieval
TOP_K=5
DATA_PATH=./data/sample.json
