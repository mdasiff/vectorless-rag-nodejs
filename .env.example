# LLM provider: 'anthropic' (direct API) or 'bedrock' (AWS)
LLM_PROVIDER=anthropic

# --- Anthropic (when LLM_PROVIDER=anthropic) ---
# Get a key from https://console.anthropic.com (Settings -> API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- AWS Bedrock (when LLM_PROVIDER=bedrock) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Retrieval
TOP_K=5
DATA_PATH=./data/sample.json
